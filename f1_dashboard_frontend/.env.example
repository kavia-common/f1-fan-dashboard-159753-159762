# Optional: CORS proxy for Ergast API (used if direct fetch fails due to CORS/network)
# The proxy should accept a full URL appended at the end. For example, AllOrigins:
# REACT_APP_CORS_PROXY_URL=https://api.allorigins.win/raw?url=

# News (optional)
# REACT_APP_NEWSAPI_KEY=<your_key>  # Note: NewsAPI may disallow browser-side use for free tier
# REACT_APP_RSS2JSON_API_URL=https://api.rss2json.com/v1/api.json

# Firebase for Chat (optional)
# REACT_APP_FIREBASE_API_KEY=...
# REACT_APP_FIREBASE_AUTH_DOMAIN=...
# REACT_APP_FIREBASE_DATABASE_URL=...
# REACT_APP_FIREBASE_PROJECT_ID=...
# REACT_APP_FIREBASE_STORAGE_BUCKET=...
# REACT_APP_FIREBASE_MESSAGING_SENDER_ID=...
# REACT_APP_FIREBASE_APP_ID=...
