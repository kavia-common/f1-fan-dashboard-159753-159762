# Frontend environment variables for F1 Fan Dashboard

# Theme/site URL (optional for email redirects in other flows)
# REACT_APP_SITE_URL=https://your-app.example.com

# News integration (optional). Using NewsAPI requires server-side per their policy; client use may be blocked.
# If provided, the app will attempt to use it; otherwise it will use RSS fallback via rss2json (rate-limited).
REACT_APP_NEWSAPI_KEY=

# RSS2JSON service URL (optional). Defaults to https://api.rss2json.com/v1/api.json
# REACT_APP_RSS2JSON_API_URL=https://api.rss2json.com/v1/api.json

# Firebase Realtime Database (optional for Chat)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
